#!/usr/bin/env python3
"""Fetch and hash images from Wikimedia Commons categories.

For each given category, lists members via the MediaWiki API, downloads
a thumbnail per file (default width 480px), perceptual-hashes it, and
writes a hash database TSV that can be matched against `phash-images`
output via `match-hashes`.

Output TSV columns:
    filename  phash  dhash  category  page_url  thumb_url
"""
import argparse
import sys
import time
import urllib.parse
from pathlib import Path

try:
    import requests
    import imagehash
    from PIL import Image
    from io import BytesIO
except ImportError:
    sys.stderr.write("Missing imagehash + Pillow + requests. Install via:\n  uv pip install imagehash Pillow requests\n")
    sys.exit(1)


API = "https://commons.wikimedia.org/w/api.php"
HEADERS = {
    "User-Agent": "ImageMatcher/0.1 (https://github.com/N4M3Z/forge-images; slide-deck research)",
    "Accept-Encoding": "gzip",
}


def request_with_retry(method, **kwargs):
    """HTTP request with exponential backoff on 429 / 503."""
    delay = 1.0
    for attempt in range(6):
        try:
            r = method(API, headers=HEADERS, timeout=30, **kwargs)
            if r.status_code in (429, 503):
                wait = float(r.headers.get("Retry-After", delay))
                time.sleep(wait)
                delay = min(delay * 2, 30)
                continue
            r.raise_for_status()
            return r
        except requests.exceptions.HTTPError as e:
            if e.response is not None and e.response.status_code in (429, 503):
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue
            raise
    raise RuntimeError(f"Exhausted retries on Wikimedia API")


def list_category(category, limit=500, recurse=False):
    """List filenames in a Wikimedia category. cmtype=file by default."""
    cmtype = "file|subcat" if recurse else "file"
    out = []
    cmcontinue = None
    fetched = 0
    while True:
        params = {
            "action": "query",
            "list": "categorymembers",
            "cmtitle": f"Category:{category}",
            "cmtype": cmtype,
            "cmlimit": min(500, limit - fetched),
            "format": "json",
        }
        if cmcontinue:
            params["cmcontinue"] = cmcontinue
        r = request_with_retry(requests.get, params=params)
        data = r.json()
        for member in data.get("query", {}).get("categorymembers", []):
            out.append(member)
        fetched = len(out)
        cmcontinue = data.get("continue", {}).get("cmcontinue")
        if not cmcontinue or fetched >= limit:
            break
        time.sleep(0.6)
    return out[:limit]


def fetch_imageinfo(titles):
    """Get URL + thumb URL for a batch of File: titles."""
    out = {}
    BATCH = 20
    for i in range(0, len(titles), BATCH):
        batch = titles[i : i + BATCH]
        params = {
            "action": "query",
            "titles": "|".join(batch),
            "prop": "imageinfo",
            "iiprop": "url|size|thumburl",
            "iiurlwidth": 480,
            "format": "json",
        }
        r = request_with_retry(requests.post, data=params)
        data = r.json()
        pages = data.get("query", {}).get("pages", {})
        for _, page in pages.items():
            title = page.get("title", "")
            info = page.get("imageinfo", [{}])[0]
            if info:
                out[title] = {
                    "page_url": info.get("descriptionurl", ""),
                    "thumb_url": info.get("thumburl", info.get("url", "")),
                    "url": info.get("url", ""),
                    "width": info.get("width", 0),
                    "height": info.get("height", 0),
                }
        time.sleep(0.6)
    return out


def hash_url(url):
    try:
        r = requests.get(url, headers=HEADERS, timeout=30)
        if r.status_code in (429, 503):
            time.sleep(float(r.headers.get("Retry-After", 5)))
            r = requests.get(url, headers=HEADERS, timeout=30)
        r.raise_for_status()
        img = Image.open(BytesIO(r.content))
        if img.mode != "RGB":
            img = img.convert("RGB")
        ph = str(imagehash.phash(img, hash_size=8))
        dh = str(imagehash.dhash(img, hash_size=8))
        return ph, dh
    except Exception as e:
        return None


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("--category", action="append", required=True, help="Wikimedia category (without 'Category:' prefix). Repeatable.")
    p.add_argument("--output", type=Path, required=True)
    p.add_argument("--limit", type=int, default=300, help="Max files per category")
    p.add_argument("--filetypes", default=".jpg,.jpeg,.png", help="Comma-separated file extensions to include")
    args = p.parse_args()

    extensions = tuple(e.strip().lower() for e in args.filetypes.split(","))

    print(f"Fetching {len(args.category)} categor{'y' if len(args.category) == 1 else 'ies'}...")
    all_files = []
    for cat in args.category:
        members = list_category(cat, args.limit)
        files = [m for m in members if m.get("ns") == 6 and m["title"].lower().endswith(extensions)]
        print(f"  {cat}: {len(members)} members → {len(files)} files matching {extensions}")
        for f in files:
            f["_category"] = cat
        all_files.extend(files)

    titles = [f["title"] for f in all_files]
    print(f"\nResolving {len(titles)} image URLs...")
    info_by_title = fetch_imageinfo(titles)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("w", encoding="utf-8") as out_f:
        out_f.write("filename\tphash\tdhash\tcategory\tpage_url\tthumb_url\n")
        ok = 0
        fail = 0
        for i, item in enumerate(all_files, 1):
            title = item["title"]
            cat = item["_category"]
            info = info_by_title.get(title)
            if not info or not info.get("thumb_url"):
                fail += 1
                continue
            result = hash_url(info["thumb_url"])
            if result is None:
                fail += 1
                continue
            ph, dh = result
            fname = title.replace("File:", "")
            out_f.write(f"{fname}\t{ph}\t{dh}\t{cat}\t{info['page_url']}\t{info['thumb_url']}\n")
            ok += 1
            if i % 25 == 0:
                print(f"  {i}/{len(all_files)} hashed...")
            time.sleep(0.2)

    print(f"\n✓ Hashed {ok}, failed {fail}")
    print(f"  Wrote {args.output}")


if __name__ == "__main__":
    main()
